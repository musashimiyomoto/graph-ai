# Postgres
POSTGRES_IMAGE=postgres:14
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Ollama
OLLAMA_IMAGE=alpine/ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# Redis
REDIS_IMAGE=redis:7-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# RAG (Qdrant + local embeddings)
RAG_QDRANT_HOST=qdrant
RAG_QDRANT_PORT=6333

# App
ENVIRONMENT=local

# Encryption
ENCRYPTION_SECRET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=

# Auth
AUTH_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Quotas (per user, per day; 0 = unlimited)
QUOTA_MAX_EXECUTIONS_PER_DAY=0
QUOTA_MAX_TOKENS_PER_DAY=0

# Prometheus metrics (set to a shared writable dir to aggregate across gunicorn
# workers + the ARQ worker; leave unset for a single-process registry)
PROMETHEUS_MULTIPROC_DIR=

# Sentry error tracking (leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0

