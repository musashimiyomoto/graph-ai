# Postgres
POSTGRES_IMAGE=postgres:14
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# Ollama
OLLAMA_IMAGE=ollama/ollama:0.31.2
OLLAMA_HOST=ollama
OLLAMA_PORT=11434

# Redis
REDIS_IMAGE=redis:7-alpine
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# RAG (Qdrant + local embeddings)
RAG_QDRANT_HOST=qdrant
RAG_QDRANT_PORT=6333

# Artifact storage (S3-compatible; MinIO locally)
ARTIFACT_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
ARTIFACT_ENDPOINT=minio:9000
ARTIFACT_PUBLIC_ENDPOINT=localhost:9000
ARTIFACT_ACCESS_KEY=graphai
ARTIFACT_SECRET_KEY=graphai-local-secret
ARTIFACT_SECURE=false
ARTIFACT_PUBLIC_SECURE=false
ARTIFACT_BUCKET=graph-ai-artifacts
ARTIFACT_MAX_UPLOAD_BYTES=20971520
ARTIFACT_MAX_USER_BYTES=524288000
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_SIGNED_URL_EXPIRE_SECONDS=300

# App
ENVIRONMENT=local

# Encryption
ENCRYPTION_SECRET_KEY=ZmDfcTF7_60GrrY167zsiPd67pEvs0aGOv2oasOM1Pg=

# Auth
AUTH_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=30

# Account emails (SMTP host may stay empty in local/test; links are logged)
AUTH_EMAIL_SMTP_HOST=
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_USERNAME=
AUTH_EMAIL_SMTP_PASSWORD=
AUTH_EMAIL_SMTP_USE_TLS=true
AUTH_EMAIL_SMTP_USE_SSL=false
AUTH_EMAIL_FROM_ADDRESS=noreply@example.com
AUTH_EMAIL_FRONTEND_URL=http://localhost:3000
AUTH_EMAIL_VERIFICATION_EXPIRE_HOURS=24
AUTH_EMAIL_PASSWORD_RESET_EXPIRE_MINUTES=60

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Quotas (per user, per day; 0 = unlimited)
QUOTA_MAX_EXECUTIONS_PER_DAY=0
QUOTA_MAX_TOKENS_PER_DAY=0

# Prometheus metrics (set to a shared writable dir to aggregate across gunicorn
# workers + the ARQ worker; leave unset for a single-process registry)
PROMETHEUS_MULTIPROC_DIR=

# Sentry error tracking (leave SENTRY_DSN empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
SENTRY_TRACES_SAMPLE_RATE=0.0
